rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Doc created by hand in Console: admins/{uid} after adding the Auth user.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminActivateUnpaidEvent() {
      return isAdmin()
        && resource.data.status == 'awaitingPayment'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }

    // Organizer cannot self-activate a pending-payment event.
    function ownerKeepsUnpaidStatus() {
      return resource.data.status != 'awaitingPayment'
        || request.resource.data.status == resource.data.status;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function eventOwnerId(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.ownerId;
    }

    function isEventOwner(eventId) {
      return isSignedIn() && eventOwnerId(eventId) == request.auth.uid;
    }

    // Ticket mutations allowed from collaborator portals (no Auth yet).
    function portalStatusTransition() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'withSeller'
            && request.resource.data.status in ['reserved', 'collected', 'settled'])
        || (resource.data.status == 'reserved'
            && request.resource.data.status in ['withSeller', 'collected', 'settled'])
        || (resource.data.status == 'collected'
            && request.resource.data.status in ['settled', 'delivered'])
        || (resource.data.status == 'settled'
            && request.resource.data.status == 'delivered');
    }

    function ticketPortalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status',
          'buyerName',
          'validatorId',
          'collectorId',
          'settleMode',
          'settledAmount',
          'history',
        ])
        && portalStatusTransition();
    }

    function ticketAssignmentUpdate() {
      return resource.data.status in ['unassigned', 'returned']
        && request.resource.data.status == 'withSeller'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'assignedByCollaboratorId', 'history'])
        && request.resource.data.sellerId is string;
    }

    function ticketReturnToPoolUpdate() {
      return resource.data.status in ['withSeller', 'reserved']
        && request.resource.data.status == 'unassigned'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'buyerName', 'assignedByCollaboratorId', 'history'])
        && request.resource.data.sellerId == null
        && request.resource.data.buyerName == ''
        && request.resource.data.assignedByCollaboratorId == null;
    }

    function ticketCollectorReturnedUpdate() {
      return resource.data.status in ['withSeller', 'reserved', 'collected']
        && request.resource.data.status == 'returned'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'buyerName', 'assignedByCollaboratorId', 'collectorId', 'history'])
        && request.resource.data.sellerId == null
        && request.resource.data.buyerName == ''
        && request.resource.data.assignedByCollaboratorId == null
        && request.resource.data.collectorId == null;
    }

    // Coordinator portal may manage sellers only (not other roles).
    function sellerOnlyCreate() {
      return request.resource.data.role == 'seller'
        && request.resource.data.name is string;
    }

    function sellerOnlyUpdate() {
      return resource.data.role == 'seller'
        && request.resource.data.role == 'seller';
    }

    function sellerOnlyDelete() {
      return resource.data.role == 'seller';
    }

    // Portal invite token for a seller (no Auth). Do not require exists():
    // in a batch, exists() sees the DB *before* the write; existsAfter would
    // be needed. Role on the token doc is enough for the current trust model.
    function sellerTokenCreate() {
      return request.resource.data.role == 'seller'
        && request.resource.data.eventId is string
        && request.resource.data.collaboratorId is string;
    }

    function sellerTokenDelete() {
      return resource.data.role == 'seller';
    }

    function sellerAccessCreate() {
      return request.resource.data.token is string;
    }

    // After the seller doc exists (or will exist in this batch).
    function sellerAccessMutate(eventId, collaboratorId) {
      return existsAfter(/databases/$(database)/documents/events/$(eventId)/collaborators/$(collaboratorId))
        && getAfter(/databases/$(database)/documents/events/$(eventId)/collaborators/$(collaboratorId)).data.role == 'seller';
    }

    function ownerUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Keep in sync with AppUser.defaultFreeEvents in the Flutter app.
    function defaultFreeEvents() {
      return 2;
    }

    function remainingFreeEvents() {
      return 'freeEvents' in get(ownerUserPath()).data
        ? get(ownerUserPath()).data.freeEvents
        : defaultFreeEvents();
    }

    function consumesFreeEventCredit() {
      return remainingFreeEvents() > 0
        && request.resource.data.status == 'active'
        && getAfter(ownerUserPath()).data.freeEvents == remainingFreeEvents() - 1;
    }

    // No free slots left: the event can be created unpaid and sit in "Por pagar".
    function isUnpaidEventCreate() {
      return remainingFreeEvents() == 0
        && request.resource.data.status == 'awaitingPayment';
    }

    function userUpdateAllowed() {
      return userChangedKeysAllowed() && freeEventsChangeAllowed();
    }

    function userChangedKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'email',
          'displayName',
          'photoUrl',
          'lastLoginAt',
          'uid',
          'freeEvents',
        ]);
    }

    // Client may fill a missing quota with the default, or consume one slot.
    // It must never raise freeEvents once the field exists (console/admin can).
    function freeEventsChangeAllowed() {
      return !('freeEvents' in request.resource.data.diff(resource.data).affectedKeys())
        || isFreeEventsBackfill()
        || isFreeEventDecrement();
    }

    function isFreeEventsBackfill() {
      return !('freeEvents' in resource.data)
        && request.resource.data.freeEvents is int
        && request.resource.data.freeEvents == defaultFreeEvents();
    }

    function isFreeEventDecrement() {
      return resource.data.freeEvents is int
        && request.resource.data.freeEvents is int
        && request.resource.data.freeEvents == resource.data.freeEvents - 1
        && request.resource.data.freeEvents >= 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['freeEvents']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.freeEvents is int
        && request.resource.data.freeEvents == defaultFreeEvents();
      allow update: if isAdmin() || (isOwner(userId) && userUpdateAllowed());
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    function couponMarkUsedByOrganizer() {
      return isSignedIn()
        && resource.data.used == false
        && (!('status' in resource.data) || resource.data.status in ['unused', 'disponible', 'available'])
        && request.resource.data.used == true
        && request.resource.data.status == 'applied'
        && request.resource.data.eventId is string
        && request.resource.data.originalAmount is number
        && request.resource.data.discountAmount is number
        && request.resource.data.finalAmount is number
        && request.resource.data.discountPercent == resource.data.discountPercent
        && request.resource.data.code == resource.data.code
        && isEventOwner(request.resource.data.eventId);
    }

    match /sellers/{sellerId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == sellerId);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;

      match /coupons/{code} {
        allow get: if isAdmin()
          || (isSignedIn() && request.auth.uid == sellerId)
          || isSignedIn();
        allow list: if isAdmin() || (isSignedIn() && request.auth.uid == sellerId);
        allow create: if isAdmin()
          && request.resource.data.code == code
          && request.resource.data.discountPercent is number
          && request.resource.data.discountPercent > 0
          && request.resource.data.discountPercent < 100
          && request.resource.data.used == false
          && request.resource.data.status == 'available';
        allow update: if isAdmin() || couponMarkUsedByOrganizer();
        allow delete: if isAdmin() && resource.data.used == false;
      }
    }

    // Pointer so the app can resolve a code without listing all coupons.
    match /couponIndex/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isAdmin() && request.resource.data.sellerId is string;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /events/{eventId} {
      allow get: if true;
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (isAdmin() && resource.data.status == 'awaitingPayment');
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (consumesFreeEventCredit() || isUnpaidEventCreate());
      allow update: if adminActivateUnpaidEvent()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && ownerKeepsUnpaidStatus());
      allow delete: if false;

      match /tickets/{ticketId} {
        allow create: if isEventOwner(eventId);
        allow update: if isEventOwner(eventId)
          || ticketPortalUpdate()
          || ticketAssignmentUpdate()
          || ticketReturnToPoolUpdate()
          || ticketCollectorReturnedUpdate();
        allow get, list: if true;
        allow delete: if false;
      }

      match /collaborators/{collaboratorId} {
        allow create: if isEventOwner(eventId) || sellerOnlyCreate();
        allow update: if isEventOwner(eventId) || sellerOnlyUpdate();
        allow delete: if isEventOwner(eventId) || sellerOnlyDelete();
        allow get, list: if true;
      }

      match /access/{collaboratorId} {
        allow get: if true;
        allow list: if isEventOwner(eventId);
        allow create: if isEventOwner(eventId)
          || sellerAccessCreate()
          || sellerAccessMutate(eventId, collaboratorId);
        allow update, delete: if isEventOwner(eventId)
          || sellerAccessMutate(eventId, collaboratorId);
      }
    }

    match /tokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if (isSignedIn()
          && eventOwnerId(request.resource.data.eventId) == request.auth.uid)
        || sellerTokenCreate();
      allow delete: if (isSignedIn()
          && eventOwnerId(resource.data.eventId) == request.auth.uid)
        || sellerTokenDelete();
      allow update: if false;
    }

    // App catalogs. Public read; only admins edit from /admin.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && docId in ['eventPricing', 'eventProducts', 'help', 'payment'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
