rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function eventOwnerId(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.ownerId;
    }

    function isEventOwner(eventId) {
      return isSignedIn() && eventOwnerId(eventId) == request.auth.uid;
    }

    // Ticket mutations allowed from collaborator portals (no Auth yet).
    function portalStatusTransition() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'withSeller'
            && request.resource.data.status in ['reserved', 'collected', 'settled'])
        || (resource.data.status == 'reserved'
            && request.resource.data.status in ['withSeller', 'collected', 'settled'])
        || (resource.data.status == 'collected'
            && request.resource.data.status in ['settled', 'delivered'])
        || (resource.data.status == 'settled'
            && request.resource.data.status == 'delivered');
    }

    function ticketPortalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status',
          'buyerName',
          'validatorId',
          'collectorId',
          'settleMode',
          'settledAmount',
          'history',
        ])
        && portalStatusTransition();
    }

    function ticketAssignmentUpdate() {
      return resource.data.status in ['unassigned', 'returned']
        && request.resource.data.status == 'withSeller'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'assignedByCollaboratorId', 'history'])
        && request.resource.data.sellerId is string;
    }

    function ticketReturnToPoolUpdate() {
      return resource.data.status in ['withSeller', 'reserved']
        && request.resource.data.status == 'unassigned'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'buyerName', 'assignedByCollaboratorId', 'history'])
        && request.resource.data.sellerId == null
        && request.resource.data.buyerName == ''
        && request.resource.data.assignedByCollaboratorId == null;
    }

    function ticketCollectorReturnedUpdate() {
      return resource.data.status in ['withSeller', 'reserved', 'collected']
        && request.resource.data.status == 'returned'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'buyerName', 'assignedByCollaboratorId', 'collectorId', 'history'])
        && request.resource.data.sellerId == null
        && request.resource.data.buyerName == ''
        && request.resource.data.assignedByCollaboratorId == null
        && request.resource.data.collectorId == null;
    }

    // Coordinator portal may manage sellers only (not other roles).
    function sellerOnlyCreate() {
      return request.resource.data.role == 'seller'
        && request.resource.data.name is string;
    }

    function sellerOnlyUpdate() {
      return resource.data.role == 'seller'
        && request.resource.data.role == 'seller';
    }

    function sellerOnlyDelete() {
      return resource.data.role == 'seller';
    }

    // Portal invite token for a seller (no Auth). Do not require exists():
    // in a batch, exists() sees the DB *before* the write; existsAfter would
    // be needed. Role on the token doc is enough for the current trust model.
    function sellerTokenCreate() {
      return request.resource.data.role == 'seller'
        && request.resource.data.eventId is string
        && request.resource.data.collaboratorId is string;
    }

    function sellerTokenDelete() {
      return resource.data.role == 'seller';
    }

    function sellerAccessCreate() {
      return request.resource.data.token is string;
    }

    // After the seller doc exists (or will exist in this batch).
    function sellerAccessMutate(eventId, collaboratorId) {
      return existsAfter(/databases/$(database)/documents/events/$(eventId)/collaborators/$(collaboratorId))
        && getAfter(/databases/$(database)/documents/events/$(eventId)/collaborators/$(collaboratorId)).data.role == 'seller';
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /events/{eventId} {
      allow get: if true;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /tickets/{ticketId} {
        allow create: if isEventOwner(eventId);
        allow update: if isEventOwner(eventId)
          || ticketPortalUpdate()
          || ticketAssignmentUpdate()
          || ticketReturnToPoolUpdate()
          || ticketCollectorReturnedUpdate();
        allow get, list: if true;
        allow delete: if false;
      }

      match /collaborators/{collaboratorId} {
        allow create: if isEventOwner(eventId) || sellerOnlyCreate();
        allow update: if isEventOwner(eventId) || sellerOnlyUpdate();
        allow delete: if isEventOwner(eventId) || sellerOnlyDelete();
        allow get, list: if true;
      }

      match /access/{collaboratorId} {
        allow get: if true;
        allow list: if isEventOwner(eventId);
        allow create: if isEventOwner(eventId)
          || sellerAccessCreate()
          || sellerAccessMutate(eventId, collaboratorId);
        allow update, delete: if isEventOwner(eventId)
          || sellerAccessMutate(eventId, collaboratorId);
      }
    }

    match /tokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if (isSignedIn()
          && eventOwnerId(request.resource.data.eventId) == request.auth.uid)
        || sellerTokenCreate();
      allow delete: if (isSignedIn()
          && eventOwnerId(resource.data.eventId) == request.auth.uid)
        || sellerTokenDelete();
      allow update: if false;
    }

    // App catalogs (products, etc.). Edit from Firebase Console.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
