rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function eventOwnerId(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.ownerId;
    }

    function isEventOwner(eventId) {
      return isSignedIn() && eventOwnerId(eventId) == request.auth.uid;
    }

    // Ticket mutations allowed from collaborator portals (no Auth yet).
    // Knowing the event id (via invite token) is the gate, so the rules also
    // pin down which fields move and in which direction.
    function portalStatusTransition() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'withSeller'
            && request.resource.data.status == 'collected')
        || (resource.data.status == 'collected'
            && request.resource.data.status in ['settled', 'delivered'])
        || (resource.data.status == 'settled'
            && request.resource.data.status == 'delivered');
    }

    function ticketPortalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'buyerName', 'validatorId', 'collectorId', 'history'])
        && portalStatusTransition();
    }

    // Coordinator (or organizer without Auth path) assigns / returns tickets.
    function ticketAssignmentUpdate() {
      return resource.data.status in ['unassigned', 'returned']
        && request.resource.data.status == 'withSeller'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'assignedByCollaboratorId', 'history'])
        && request.resource.data.sellerId is string;
    }

    function ticketReturnToPoolUpdate() {
      return resource.data.status == 'withSeller'
        && request.resource.data.status == 'unassigned'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'buyerName', 'assignedByCollaboratorId', 'history'])
        && request.resource.data.sellerId == null
        && request.resource.data.buyerName == ''
        && request.resource.data.assignedByCollaboratorId == null;
    }

    // Collector marks cobrado / en poder as "devuelto" → free pool for reassignment.
    function ticketCollectorReturnedUpdate() {
      return resource.data.status in ['withSeller', 'collected']
        && request.resource.data.status == 'returned'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sellerId', 'buyerName', 'assignedByCollaboratorId', 'collectorId', 'history'])
        && request.resource.data.sellerId == null
        && request.resource.data.buyerName == ''
        && request.resource.data.assignedByCollaboratorId == null
        && request.resource.data.collectorId == null;
    }

    // Coordinator portal may manage sellers only (not other roles).
    function sellerOnlyCreate() {
      return request.resource.data.role == 'seller'
        && request.resource.data.name is string;
    }

    function sellerOnlyUpdate() {
      return resource.data.role == 'seller'
        && request.resource.data.role == 'seller';
    }

    function sellerOnlyDelete() {
      return resource.data.role == 'seller';
    }

    function sellerTokenCreate() {
      return request.resource.data.keys().hasAll(['eventId', 'collaboratorId', 'role'])
        && request.resource.data.role == 'seller'
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)/collaborators/$(request.resource.data.collaboratorId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)/collaborators/$(request.resource.data.collaboratorId)).data.role == 'seller';
    }

    function sellerTokenDelete() {
      return resource.data.role == 'seller';
    }

    // Organizer profile: only the signed-in user can read/write their own doc.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Events owned by the organizer.
    match /events/{eventId} {
      // Public get by unguessable id (collaborator portals).
      allow get: if true;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /tickets/{ticketId} {
        allow create: if isEventOwner(eventId);
        allow update: if isEventOwner(eventId)
          || ticketPortalUpdate()
          || ticketAssignmentUpdate()
          || ticketReturnToPoolUpdate()
          || ticketCollectorReturnedUpdate();
        allow get, list: if true;
        allow delete: if false;
      }

      // Public profile of each collaborator. Holds no credentials: the invite
      // token lives in /access. Coordinator portal may CUD sellers only.
      match /collaborators/{collaboratorId} {
        allow create: if isEventOwner(eventId) || sellerOnlyCreate();
        allow update: if isEventOwner(eventId) || sellerOnlyUpdate();
        allow delete: if isEventOwner(eventId) || sellerOnlyDelete();
        allow get, list: if true;
      }

      // Invite tokens. Get is open so portals can share; list stays owner-only.
      match /access/{collaboratorId} {
        allow get: if true;
        allow list: if isEventOwner(eventId);
        allow create, update, delete: if isEventOwner(eventId)
          || exists(/databases/$(database)/documents/events/$(eventId)/collaborators/$(collaboratorId))
            && get(/databases/$(database)/documents/events/$(eventId)/collaborators/$(collaboratorId)).data.role == 'seller';
      }
    }

    // Opaque invite tokens. Knowing the doc id is the credential, so reads are
    // per-document only: listing the collection would hand out every access.
    match /tokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if (isSignedIn()
          && eventOwnerId(request.resource.data.eventId) == request.auth.uid)
        || sellerTokenCreate();
      allow delete: if (isSignedIn()
          && eventOwnerId(resource.data.eventId) == request.auth.uid)
        || sellerTokenDelete();
      allow update: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
