rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function eventOwnerId(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.ownerId;
    }

    // Organizer profile: only the signed-in user can read/write their own doc.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Events owned by the organizer.
    match /events/{eventId} {
      // Public get by unguessable id (collaborator portals).
      allow get: if true;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /tickets/{ticketId} {
        allow create, update: if isSignedIn()
          && eventOwnerId(eventId) == request.auth.uid;
        // Temporary open read for portals; tighten when ticket ops land.
        allow get, list: if true;
        allow delete: if false;
      }

      match /collaborators/{collaboratorId} {
        allow create, update: if isSignedIn()
          && eventOwnerId(eventId) == request.auth.uid;
        allow list: if isSignedIn()
          && eventOwnerId(eventId) == request.auth.uid;
        allow get: if true;
        allow delete: if false;
      }
    }

    // Opaque invite tokens. Knowing the doc id is the credential.
    match /tokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && eventOwnerId(request.resource.data.eventId) == request.auth.uid;
      allow delete: if isSignedIn()
        && eventOwnerId(resource.data.eventId) == request.auth.uid;
      allow update: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
